# Real OSM snapshot from Erlan; use poi_sample.json and DATA_KIND=sample for isolated fixtures.
POI_PATH=data/poi.json
DATA_KIND=real
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_PLACES_API_KEY=
# Enable only after the Google Cloud owner verifies a hard quota and free allowance.
GOOGLE_PLACES_ENABLED=false
# 2GIS demo key: on-demand ratings/hours; no photos or automatic bulk collection.
TWOGIS_API_KEY=
TWOGIS_ENABLED=false
TWOGIS_SEARCH_ENABLED=true
AIRPORT_RESERVE_MIN=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://seruen-astana.netlify.app
MOCK_MODE=false
WARM_CACHE=true
HOST=127.0.0.1
PORT=8000

# Place photos + Gemini photo analysis (docs/photos.md)
PHOTOS_ENABLED=true
PHOTO_INDEX_URL=https://seruen-astana.netlify.app/img/places/index.json
